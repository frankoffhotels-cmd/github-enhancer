{
  "manifest_version": 3,
  "name": "GitHub Enhancer",
  "version": "1.0",
  "description": "Enhances GitHub UI with copy and download buttons",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}